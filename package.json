{
  "name": "evemange-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @evemange/api & npm run dev -w @evemange/web",
    "dev:api": "npm run dev -w @evemange/api",
    "dev:web": "npm run dev -w @evemange/web",
    "build": "npm run build -w @evemange/api && npm run build -w @evemange/web",
    "typecheck": "npm run typecheck -w @evemange/api && npm run typecheck -w @evemange/web",
    "lint": "npm run lint -w @evemange/api && npm run lint -w @evemange/web",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "npm run db:generate -w @evemange/api",
    "db:migrate:dev": "npm run db:migrate:dev -w @evemange/api",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @evemange/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  }
}
