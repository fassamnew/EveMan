# API
API_PORT=5001
NODE_ENV=development
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=ChangeMe123!
CORS_ORIGINS=http://localhost:3500

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=evemange
MYSQL_USER=evemange
MYSQL_PASSWORD=evemange_dev
DATABASE_URL=mysql://evemange:evemange_dev@localhost:3307/evemange

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Object storage (S3 compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=evemange-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Telemetry
OTEL_ENABLED=true
OTEL_DEBUG=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
