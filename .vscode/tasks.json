{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Backend Server",
			"type": "shell",
			"command": "cd server && npm run dev",
			"isBackground": true,
			"problemMatcher": [
				"$tsc-watch"
			]
		},
		{
			"label": "Start Frontend Client",
			"type": "shell",
			"command": "cd client && npm start",
			"isBackground": true,
			"problemMatcher": [
				"$ts-node-dev"
			]
		}
	]
}