generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ORG_ADMIN
  ORG_STAFF
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LinkVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum LinkApprovalMode {
  AUTO
  MANUAL
}

enum FormFieldType {
  TEXT
  TEXTAREA
  EMAIL
  NUMBER
  SELECT
  CHECKBOX
}

enum BadgeStatus {
  PENDING
  RENDERING
  READY
  FAILED
  REVOKED
}

enum QrTokenStatus {
  ACTIVE
  VERIFIED
  REVOKED
  EXPIRED
}

model MigrationMetadata {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("migration_metadata")
}

model Organization {
  id         String      @id @default(uuid())
  code       String      @unique
  name       String
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  userRoles  UserRole[]
  invites    Invite[]
  tokens     RefreshToken[]
  auditLogs  AuditLog[]
  events     Event[]
  registrationLinks RegistrationLink[]
  registrants Registrant[]
  badgeTemplates BadgeTemplate[]
  badges Badge[]
  qrCodes QrCode[]

  @@map("organizations")
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  passwordHash      String?
  firstName         String?
  lastName          String?
  isActive          Boolean        @default(true)
  failedLoginCount  Int            @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  userRoles         UserRole[]
  refreshTokens     RefreshToken[]
  invitesCreated    Invite[]       @relation("InviteCreatedBy")
  auditLogs         AuditLog[]     @relation("AuditActor")

  @@map("users")
}

model Role {
  id          String      @id @default(uuid())
  name        RoleName    @unique
  description String?
  isSystem    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userRoles   UserRole[]
  invites     Invite[]

  @@map("roles")
}

model UserRole {
  id             String         @id @default(uuid())
  userId         String
  roleId         String
  organizationId String?
  createdAt      DateTime       @default(now())
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId])
  @@index([organizationId])
  @@map("user_roles")
}

model RefreshToken {
  id               String         @id @default(uuid())
  userId           String
  organizationId   String?
  tokenHash        String         @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedByTokenId String?
  createdByIp      String?
  lastUsedAt       DateTime?
  lastUsedIp       String?
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Invite {
  id              String        @id @default(uuid())
  organizationId  String
  email           String
  roleId          String
  tokenHash       String        @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  invitedByUserId String
  createdAt       DateTime      @default(now())
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role            Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy       User          @relation("InviteCreatedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, email])
  @@map("invites")
}

model AuditLog {
  id             String         @id @default(uuid())
  actorUserId    String?
  organizationId String?
  action         String
  targetType     String
  targetId       String?
  outcome        AuditOutcome
  ipAddress      String?
  metadataJson   Json?
  createdAt      DateTime       @default(now())
  actorUser      User?          @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model Event {
  id             String             @id @default(uuid())
  organizationId String
  name           String
  description    String?
  status         EventStatus        @default(DRAFT)
  startsAt       DateTime?
  endsAt         DateTime?
  archivedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  links          RegistrationLink[]
  registrants    Registrant[]
  badges         Badge[]
  qrCodes        QrCode[]

  @@index([organizationId, createdAt])
  @@map("events")
}

model RegistrationLink {
  id             String          @id @default(uuid())
  eventId        String
  organizationId String
  slug           String
  title          String
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule           LinkRule?
  formFields     FormField[]
  registrants    Registrant[]
  badgeTemplateId String?
  badgeTemplate  BadgeTemplate? @relation(fields: [badgeTemplateId], references: [id], onDelete: SetNull)
  badges         Badge[]

  @@unique([eventId, slug])
  @@index([organizationId, slug])
  @@index([badgeTemplateId])
  @@map("registration_links")
}

model LinkRule {
  id                 String             @id @default(uuid())
  registrationLinkId String             @unique
  visibility         LinkVisibility     @default(PUBLIC)
  capacity           Int?
  approvalMode       LinkApprovalMode   @default(AUTO)
  opensAt            DateTime?
  closesAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  registrationLink   RegistrationLink   @relation(fields: [registrationLinkId], references: [id], onDelete: Cascade)

  @@index([visibility, opensAt, closesAt])
  @@map("link_rules")
}

model FormField {
  id                 String          @id @default(uuid())
  registrationLinkId String
  key                String
  label              String
  type               FormFieldType
  required           Boolean         @default(true)
  position           Int             @default(0)
  placeholder        String?
  optionsJson        Json?
  minLength          Int?
  maxLength          Int?
  minValue           Float?
  maxValue           Float?
  pattern            String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  registrationLink   RegistrationLink @relation(fields: [registrationLinkId], references: [id], onDelete: Cascade)
  responses          RegistrantResponse[]

  @@unique([registrationLinkId, key])
  @@index([registrationLinkId, position])
  @@map("form_fields")
}

model Registrant {
  id                   String            @id @default(uuid())
  organizationId       String
  eventId              String
  registrationLinkId   String
  referenceCode        String            @unique
  email                String
  fullName             String
  consentAccepted      Boolean           @default(false)
  consentPolicyVersion String
  consentCapturedAt    DateTime
  confirmationSentAt   DateTime?
  ipAddress            String?
  userAgent            String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event                Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationLink     RegistrationLink  @relation(fields: [registrationLinkId], references: [id], onDelete: Cascade)
  responses            RegistrantResponse[]
  qrCodes              QrCode[]
  badges               Badge[]

  @@unique([registrationLinkId, email])
  @@index([eventId, createdAt])
  @@map("registrants")
}

model RegistrantResponse {
  id           String      @id @default(uuid())
  registrantId String
  formFieldId  String?
  fieldKey     String
  valueText    String
  createdAt    DateTime    @default(now())
  registrant   Registrant  @relation(fields: [registrantId], references: [id], onDelete: Cascade)
  formField    FormField?  @relation(fields: [formFieldId], references: [id], onDelete: SetNull)

  @@unique([registrantId, fieldKey])
  @@index([formFieldId])
  @@map("registrant_responses")
}

model BadgeTemplate {
  id             String            @id @default(uuid())
  organizationId String
  name           String
  version        Int               @default(1)
  configJson     Json
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  links          RegistrationLink[]
  badges         Badge[]

  @@unique([organizationId, name, version])
  @@index([organizationId, isActive])
  @@map("badge_templates")
}

model QrCode {
  id             String        @id @default(uuid())
  registrantId   String
  organizationId String
  eventId        String
  tokenHash      String?       @unique
  status         QrTokenStatus @default(ACTIVE)
  expiresAt      DateTime?
  lastVerifiedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  registrant     Registrant    @relation(fields: [registrantId], references: [id], onDelete: Cascade)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  badges         Badge[]

  @@index([organizationId, status])
  @@index([eventId, status])
  @@map("qr_codes")
}

model Badge {
  id                 String         @id @default(uuid())
  registrantId       String
  organizationId     String
  eventId            String
  registrationLinkId String
  badgeTemplateId    String?
  qrCodeId           String?
  status             BadgeStatus    @default(PENDING)
  storagePath        String?
  renderedAt         DateTime?
  deliveredAt        DateTime?
  failureReason      String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  registrant         Registrant     @relation(fields: [registrantId], references: [id], onDelete: Cascade)
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event              Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrationLink   RegistrationLink @relation(fields: [registrationLinkId], references: [id], onDelete: Cascade)
  badgeTemplate      BadgeTemplate? @relation(fields: [badgeTemplateId], references: [id], onDelete: SetNull)
  qrCode             QrCode?        @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([registrantId, createdAt])
  @@index([qrCodeId])
  @@map("badges")
}
