{
  "expo": {
    "name": "EveMange Usher",
    "slug": "evemange-usher",
    "version": "0.1.0",
    "orientation": "portrait",
    "splash": {
      "backgroundColor": "#020617"
    },
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "EveMange uses the camera to scan attendee QR codes for check-ins.",
        "UIBackgroundModes": [
          "fetch"
        ]
      }
    },
    "android": {
      "permissions": [
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "WAKE_LOCK"
      ]
    },
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}
